# EaglerXHorizon environment template.
# Copy to .env and fill in. Never commit the filled file.

# ----------------------------------------------------------------------------
# Proxy (deploy/oracle-cloud.md)
# ----------------------------------------------------------------------------
HORIZON_DOMAIN=proxy.example.com
HORIZON_BACKEND=127.0.0.1:25566
HORIZON_LISTEN=0.0.0.0:8081
HORIZON_CLIENT_DIR=/srv/eaglerxhorizon/web
HORIZON_WS_PATH=/ws

# Comma separated origins allowed to open a WebSocket.
HORIZON_ALLOWED_ORIGINS=https://proxy.example.com,http://localhost:8000

# Velocity modern forwarding secret (only for the velocity-eagler.toml stack).
HORIZON_FORWARDING_SECRET_FILE=/etc/eaglerxhorizon/forwarding.secret

# ----------------------------------------------------------------------------
# Base44 backend
# ----------------------------------------------------------------------------
# Functions base URL used by web/bootstrap.js as window.HORIZON_API.baseUrl
HORIZON_API_BASE=https://<your-app>.base44.app/functions

# Stored in the HorizonConfig entity, not here, but kept for local tooling:
#   microsoft_client_id           -> Azure app id used by horizonAuth
#   admin_write_token_sha256      -> SHA-256 of the write token for server/node writes
HORIZON_ADMIN_TOKEN=
MICROSOFT_CLIENT_ID=

# ----------------------------------------------------------------------------
# Local development
# ----------------------------------------------------------------------------
HORIZON_DEV_PORT=8000
RUST_LOG=eaglerxhorizon=debug,info
